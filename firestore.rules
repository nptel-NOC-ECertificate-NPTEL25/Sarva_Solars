rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Leads collection
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Job Applications collection
    match /jobApplications/{appId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Services collection
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Subsidies collection
    match /subsidies/{subsidyId} {
      allow read, write: if true;
    }

    // Testimonials collection
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // FAQs collection
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // Gallery collection
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Hero Slides collection
    match /heroSlides/{slideId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Visitor Logs collection
    match /visitorLogs/{logId} {
      allow read, write: if true;
    }

    // Email Notifications collection
    match /emailNotifications/{mailId} {
      allow read, write: if true;
    }

    // Auth Passwords collection
    match /auth_passwords/{passId} {
      allow read, write: if true;
    }
  }
}

